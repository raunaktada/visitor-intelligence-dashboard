{
  "name": "visitor-intelligence-dashboard",
  "version": "1.0.0",
  "scripts": {
    "server:dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "server:build": "tsc -p tsconfig.json",
    "server:start": "node dist/server.js",
    "client:dev": "cd client && npm start",
    "client:build": "cd client && npm run build",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\""
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^134.0.0",
    "node-cron": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
